# ==============================================================================
# 1. DATABASE UTAMA (Hostinger MySQL - Prisma ORM)
# ==============================================================================
# Database tunggal dan resmi untuk website publik dan dashboard admin.
# Dapatkan kredensial dari cPanel / hPanel Hostinger:
# Databases -> MySQL Databases -> Create New Database & User.
#
# Format: mysql://<username>:<password>@<host>:3306/<database_name>?connection_limit=10&connect_timeout=10
# Contoh Hostinger MySQL:
DATABASE_URL="mysql://u123456789_aksara:KataSandiKuat123@localhost:3306/u123456789_aksaradb"

# ==============================================================================
# 2. DOMAIN, ORIGIN & AUTH (Untuk VPS / Hostinger Deployment)
# ==============================================================================
# URL situs dan daftar domain yang diizinkan untuk CORS (pisahkan dengan koma)
NEXTAUTH_URL="https://sahabataksara.id"
ALLOWED_ORIGINS="sahabataksara.id,www.sahabataksara.id"
NEXT_PUBLIC_SITE_URL="https://sahabataksara.id"

# ==============================================================================
# 3. KREDENSIAL LOGIN ADMIN & SESI ENKRIPSI
# ==============================================================================
# Kredensial akun pengurus untuk masuk ke panel /admin
ADMIN_DEFAULT_EMAIL="admin@sahabataksara.id"
ADMIN_DEFAULT_PASSWORD="GantiDenganPasswordKuatAnda123"

# Kunci rahasia untuk mengenkripsi cookie sesi admin (wajib minimal 32 karakter acak)
# Contoh generate di bash/powershell: openssl rand -base64 32
ADMIN_SESSION_SECRET="ganti-dengan-string-acak-rahasia-minimal-32-karakter-keamanan"

# ==============================================================================
# 4. STORAGE / PENYIMPANAN FOTO DOKUMENTASI
# ==============================================================================
# JIKA LOCALHOST / HOSTINGER NODE.JS (Disk Lokal):
# Kosongkan BLOB_READ_WRITE_TOKEN! Sistem otomatis menyimpan seluruh file foto
# langsung ke disk server lokal di direktori 'public/uploads/' (format WebP & terkompresi).
#
# JIKA VERCEL (Cloud Storage):
# Masukkan token Vercel Blob jika Anda ingin foto diunggah ke CDN Vercel Blob:
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
BLOB_READ_WRITE_TOKEN=

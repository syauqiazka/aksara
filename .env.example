# ==============================================================================
# 1. DATABASE UTAMA (PostgreSQL Lokal / VPS Server - Prisma ORM)
# ==============================================================================
# Diutamakan sebagai lapisan PRIMER oleh sistem.
# Jika diisi, seluruh operasi baca (publik) dan tulis (admin) akan langsung masuk
# ke database PostgreSQL ini melalui Prisma Client.
#
# Format: postgresql://<user>:<password>@<host>:<port>/<nama_db>
DATABASE_URL="postgresql://postgres:password@localhost:5432/zyba_account"
DATABASE_URL_ACCOUNT="postgresql://postgres:password@localhost:5432/zyba_account"
DIRECT_URL_ACCOUNT="postgresql://postgres:password@localhost:5432/zyba_account"

# ==============================================================================
# 2. DATABASE CADANGAN / FALLBACK (Supabase - Opsional)
# ==============================================================================
# Sistem HANYA akan menghubungi Supabase apabila database lokal di atas mengalami
# gangguan/error koneksi atau jika variabel DATABASE_URL di atas tidak diisi.
# Jika Anda hanya ingin memakai PostgreSQL lokal murni, bagian ini boleh dikosongkan.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# 3. DOMAIN, ORIGIN & AUTH (Untuk VPS / Server Deployment)
# ==============================================================================
# URL situs dan daftar domain yang diizinkan untuk CORS (pisahkan dengan koma)
NEXTAUTH_URL="https://jhic.zyba.my.id"
ALLOWED_ORIGINS="jhic.zyba.my.id,zyba.my.id,www.zyba.my.id"
NEXT_PUBLIC_SITE_URL="https://jhic.zyba.my.id"

# ==============================================================================
# 4. KREDENSIAL LOGIN ADMIN & SESI ENKRIPSI
# ==============================================================================
# Kredensial akun pengurus untuk masuk ke panel /admin
ADMIN_DEFAULT_EMAIL="admin@gmail.com"
ADMIN_DEFAULT_PASSWORD="GantiDenganPasswordKuatAnda"

# Kunci rahasia untuk mengenkripsi cookie sesi admin (wajib minimal 32 karakter acak)
# Contoh generate di bash/powershell: openssl rand -base64 32
ADMIN_SESSION_SECRET="ganti-dengan-string-acak-rahasia-minimal-32-karakter-keamanan"

# ==============================================================================
# 5. STORAGE / PENYIMPANAN FOTO DOKUMENTASI
# ==============================================================================
# JIKA LOCALHOST / VPS:
# Kosongkan BLOB_READ_WRITE_TOKEN! Sistem otomatis menyimpan seluruh file foto
# langsung ke disk server lokal di direktori 'public/uploads/' (format WebP & terkompresi).
#
# JIKA VERCEL (Cloud Storage):
# Masukkan token Vercel Blob jika Anda ingin foto diunggah ke CDN Vercel Blob.
BLOB_READ_WRITE_TOKEN=
